# Image and exposed application port.
APP_IMAGE=ghcr.io/your-github-org/zhiguang-be:v0.1.0
APP_PORT=18080

# MySQL. Use long random values in production.
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=zhiguang_prod
MYSQL_APP_USERNAME=zhiguang_app
MYSQL_APP_PASSWORD=change-me-app-password

# Redis. Use a long random value in production.
SPRING_DATA_REDIS_PASSWORD=change-me-redis-password
SPRING_DATA_REDIS_DATABASE=0

# Spring profile and infrastructure endpoints inside the Docker network.
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/zhiguang_prod?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=zhiguang_app
SPRING_DATASOURCE_PASSWORD=change-me-app-password
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
SPRING_ELASTICSEARCH_URIS=http://elasticsearch:9200

# Canal client settings used by the Spring Boot app.
CANAL_ENABLED=true
CANAL_HOST=canal
CANAL_PORT=11111
CANAL_DESTINATION=example
CANAL_USERNAME=
CANAL_PASSWORD=
CANAL_FILTER=zhiguang\.outbox

# AI providers. Keep empty if the feature is temporarily disabled.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
DASHSCOPE_API_KEY=

# Aliyun OSS.
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_PUBLIC_DOMAIN=
OSS_FOLDER=avatars

# JWT keys are mounted as files by compose.prod.yaml.
AUTH_JWT_PRIVATE_KEY=file:/run/secrets/jwt-private.pem
AUTH_JWT_PUBLIC_KEY=file:/run/secrets/jwt-public.pem
